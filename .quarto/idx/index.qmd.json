ent>\n        <radialGradient id=\"core-light\">\n          <stop offset=\"0\" stop-color=\"#C8FF68\" stop-opacity=\".8\" />\n          <stop offset=\"1\" stop-color=\"#C8FF68\" stop-opacity=\"0\" />\n        </radialGradient>\n      </defs>\n      <g class=\"instrument-grid\" aria-hidden=\"true\">\n        <path d=\"M58 96H582M58 182H582M58 268H582M58 354H582M58 440H582\" />\n        <path d=\"M112 48V492M216 48V492M320 48V492M424 48V492M528 48V492\" />\n      </g>\n      <g class=\"instrument-rails\" fill=\"none\" stroke-linecap=\"round\">\n        <path class=\"rail\" d=\"M74 122H178L224 166H300\" />\n        <path class=\"rail\" d=\"M74 258H164L210 212H300\" />\n        <path class=\"rail\" d=\"M74 394H178L224 348H300\" />\n        <path class=\"rail rail-muted\" d=\"M300 166H352L394 122H548\" />\n        <path class=\"rail rail-muted\" d=\"M300 280H396L442 326H548\" />\n        <path class=\"rail rail-muted\" d=\"M300 348H352L394 394H548\" />\n        <circle cx=\"300\" cy=\"280\" r=\"88\" />\n        <circle cx=\"300\" cy=\"280\" r=\"62\" />\n      </g>\n      <g class=\"instrument-pulses\" aria-hidden=\"true\">\n<circle class=\"pulse pulse-one\" cx=\"224\" cy=\"166\" r=\"4\" />\n<circle class=\"pulse pulse-two\" cx=\"224\" cy=\"348\" r=\"4\" />\n<circle class=\"pulse pulse-three\" cx=\"394\" cy=\"122\" r=\"4\" />\n      </g>\n      <circle class=\"core-light\" cx=\"300\" cy=\"280\" r=\"108\" fill=\"url(#core-light)\" />\n      <g class=\"instrument-points\">\n        <g class=\"source source-a\"><circle cx=\"74\" cy=\"122\" r=\"7\" /><text x=\"74\" y=\"96\">REPORT</text></g>\n        <g class=\"source source-b\"><circle cx=\"74\" cy=\"258\" r=\"7\" /><text x=\"74\" y=\"232\">SOURCE</text></g>\n        <g class=\"source source-c\"><circle cx=\"74\" cy=\"394\" r=\"7\" /><text x=\"74\" y=\"430\">WORKFLOW</text></g>\n        <g class=\"decision-core\"><circle cx=\"300\" cy=\"280\" r=\"25\" /><path d=\"M289 280l8 8 15-18\" /></g>\n        <g class=\"output\"><circle cx=\"548\" cy=\"122\" r=\"7\" /><text x=\"548\" y=\"96\" text-anchor=\"end\">DECISION READY</text></g>\n        <g class=\"output\"><circle cx=\"548\" cy=\"326\" r=\"7\" /><text x=\"548\" y=\"362\" text-anchor=\"end\">REFRESH AUTOMATED</text></g>\n        <g class=\"output\"><circle cx=\"548\" cy=\"394\" r=\"7\" /><text x=\"548\" y=\"430\" text-anchor=\"end\">SOURCE MAPPED</text></g>\n      </g>\n    </svg>\n    <div class=\"instrument-readout\"><span>STATUS</span><strong>Clarity increasing</strong><span class=\"readout-dot\" aria-hidden=\"true\"></span></div>\n  </div>\n</section>\n\n<section class=\"credibility-rail section-grid\" aria-labelledby=\"credibility-title\">\n  <p class=\"section-kicker\">Context matters</p>\n  <div>\n    <h2 id=\"credibility-title\">Built for data-heavy,<br><em>high-accountability</em> environments.</h2>\n    <ul class=\"domain-list\" aria-label=\"Experience domains\">\n      <li>Healthcare</li><li>Financial services</li><li>Sports intelligence</li><li>Operational analytics</li>\n    </ul>\n  </div>\n</section>\n\n<section class=\"manifesto section-grid\" aria-labelledby=\"manifesto-title\">\n  <p class=\"section-kicker\">The point of the system</p>\n  <div class=\"manifesto-copy\">\n    <h2 id=\"manifesto-title\">Good technology should make work feel <em>lighter.</em></h2>\n    <p>We connect scattered data, automate recurring reporting, and build decision tools teams can actually use. Clear architecture. Thoughtful governance. No black-box theater.</p>\n  </div>\n</section>\n\n<section class=\"offer-section section-grid\" aria-labelledby=\"offer-title\">\n  <div class=\"offer-intro\">\n    <p class=\"eyebrow\">Featured engagement <span>·</span> reporting automation</p>\n    <h2 id=\"offer-title\">Make the report<br><em>run itself.</em></h2>\n    <p>The Reporting Automation Sprint turns one recurring, manual reporting workflow into a reliable system—documented, monitored, and ready for your team.</p>\n    <a class=\"text-link\" href=\"contact.html\">Tell us what you report every week <span aria-hidden=\"true\">↗</span></a>\n  </div>\n  <ol class=\"flow-list\">\n    <li>\n      <span class=\"flow-number\">01</span>\n      <div><h3>Map the workflow</h3><p>Identify sources, handoffs, calculations, and the decision the report must support.</p></div>\n    </li>\n    <li>\n      <span class=\"flow-number\">02</span>\n      <div><h3>Automate the pipeline</h3><p>Connect inputs, clean and transform data, and create a repeatable refresh path.</p></div>\n    </li>\n    <li>\n      <span class=\"flow-number\">03</span>\n      <div><h3>Deliver the decision layer</h3><p>Ship the report, dashboard, or alerting experience with documentation and handoff.</p></div>\n    </li>\n  </ol>\n</section>\n\n<section class=\"capabilities-section section-grid\" aria-labelledby=\"capabilities-title\">\n  <div class=\"section-heading\">\n    <p class=\"section-kicker\">What we build</p>\n    <h2 id=\"capabilities-title\">The system around<br><em>the signal.</em></h2>\n  </div>\n  <ol class=\"capability-list\">\n    <li><span>01</span><div><h3>Reporting &amp; workflow automation</h3><p>Replace spreadsheet relay races with tested, repeatable pipelines.</p></div></li>\n    <li><span>02</span><div><h3>Data platforms &amp; integrations</h3><p>Connect APIs, operational systems, warehouses, and governed data models.</p></div></li>\n    <li><span>03</span><div><h3>Analytics &amp; decision systems</h3><p>Build dashboards and analytical products that answer a business question, not merely display metrics.</p></div></li>\n    <li><span>04</span><div><h3>Applied AI &amp; internal tools</h3><p>Use AI where it creates leverage—search, classification, summarization, forecasting, and workflow assistance—with appropriate human oversight.</p></div></li>\n    <li><span>05</span><div><h3>Governance &amp; ongoing improvement</h3><p>Design traceable, secure, maintainable workflows for high-accountability environments.</p></div></li>\n  </ol>\n<